    <!-- Onboarding -->
    <string name="onboarding_intro_title">This week\'s you,\nas a food label.</string>
    <string name="onboarding_intro_body">Every Sunday evening we turn what your phone already records (app usage, steps, screen-off time) into a single label. Nothing to type in.</string>
    <string name="onboarding_privacy_title">Nothing leaves\nyour device.</string>
    <string name="onboarding_privacy_body">· Everything is calculated on this phone.\n· There is no server. Nothing is sent anywhere.\n· You choose what shows up on the card.\n\nBefore granting any permission, try it with 5 quick questions.</string>
    <string name="onboarding_next">Next</string>
    <string name="onboarding_try_quiz">Try with 5 questions</string>

