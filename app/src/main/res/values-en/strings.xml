    <!-- Onboarding -->
    <string name="onboarding_intro_title">This week\'s you,\nas a food label.</string>
    <string name="onboarding_intro_body">Every Sunday evening we turn what your phone already records (app usage, steps, screen-off time) into a single label. Nothing to type in.</string>
